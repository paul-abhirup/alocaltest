# =============================================================================
# CVOLVE PRO — environment template
# Copy to .env and fill in:   cp .env.example .env
# Real values live on the VPS in /opt/cvolvepro/CVOLVE-PRO/.streamlit/secrets.toml
# (recover them following docs/VPS_RECOVERY.md). NEVER commit .env.
# =============================================================================

# --- Database (required) ---

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=cvolvepro
DB_USER=postgres
DB_PASSWORD=cvolve_local_2026

# --- Auth (required for FastAPI JWT) ---
JWT_SECRET=CHANGE_ME_random_string
FLASK_SECRET=CHANGE_ME_random_string

# --- AI (GEMINI_API_KEY required for CV/cover-letter/interview generation) ---
GEMINI_API_KEY=
# GOOGLE_API_KEY is an accepted alias for GEMINI_API_KEY
GOOGLE_API_KEY=
# Only needed for the "Premium Classic" model
OPENAI_API_KEY=

# --- Stripe (only for billing/checkout features) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_JOBSQA_WEBHOOK_SECRET=

# --- Email OTP via Resend (only for registration emails) ---
RESEND_API_KEY=
FROM_EMAIL=CVolve <no-reply@cvolvepro.com>
APP_FROM_EMAIL=

# --- SMTP (only used by smtp_test.py) ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Job aggregator (Phase 1) — optional Tier B sources (Tier A works without keys) ---
# Adzuna free tier: https://developer.adzuna.com/  → app_id + app_key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# RapidAPI JSearch: https://rapidapi.com/letscrape-6af2-default/api/jsearch
JSEARCH_API_KEY=
# Jooble free API key: https://jooble.org/api/about
JOOBLE_API_KEY=""
# Findwork.dev developer jobs API: https://findwork.dev/api/
FINDWORK_API_KEY=
JOB_CACHE_TTL_MIN=30

# --- Admin (voucher management) ---
# Comma-separated emails allowed to open the "Admin · Vouchers" page.
ADMIN_EMAILS=

# --- Interview module (voice answers + AI evaluation) ---
# Deepgram: used to transcribe recorded voice answers (optional; demo-mode fallback without it)
DEEPGRAM_API_KEY=
# Groq: free alternative LLM backend for question generation / answer evaluation (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Azure Speech (only used by standalone_interview.py launcher, not the main app)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --- Tunables (defaults are fine) ---
CV_CREDIT_COST=3
CV_MAX_PAGES=2
DEFAULT_TEMPLATE=professional
PORT=8000
